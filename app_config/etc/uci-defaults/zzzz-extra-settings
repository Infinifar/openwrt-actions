#!/bin/sh
# Public first boot: retain upstream LAN/DHCP/SSH/firewall topology.
# BEGIN personal Argon defaults
theme=argon
if [ -s "/www/luci-static/$theme/css/cascade.css" ] &&
   [ -s "/usr/share/ucode/luci/template/themes/$theme/header.ut" ] &&
   [ -s "/usr/share/ucode/luci/template/themes/$theme/footer.ut" ] &&
   [ -s "/usr/share/ucode/luci/template/themes/$theme/sysauth.ut" ]; then
    uci set luci.themes.Argon=/luci-static/$theme
    uci set luci.main.mediaurlbase=/luci-static/$theme
    if uci -q get 'argon.@global[0]' >/dev/null; then
        uci set 'argon.@global[0].online_wallpaper=none'
        uci commit argon
    fi
    uci commit luci
else
    logger -t lede-personal 'Argon resources missing; leaving the current LuCI theme unchanged.'
fi
# END personal Argon defaults

# Empty public identity/account templates must not start exposed services.
for service in AdGuardHome adguardhome openclash tailscale beszel-agent zerotier; do
    if [ -x "/etc/init.d/$service" ]; then
        "/etc/init.d/$service" disable
    fi
done
exit 0
