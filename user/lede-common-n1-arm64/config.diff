# 配置
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y

# 机型选择
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y

# Target Images
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_IMAGES_GZIP is not set

# 额外包
# CONFIG_PACKAGE_autocore-arm is not set
# CONFIG_PACKAGE_automount is not set
CONFIG_PACKAGE_autosamba=y
CONFIG_PACKAGE_autosamba_INCLUDE_KSMBD=y
# CONFIG_PACKAGE_autosamba_INCLUDE_SAMBA3 is not set
# CONFIG_PACKAGE_autosamba_INCLUDE_SAMBA4 is not set
CONFIG_PACKAGE_ipv6helper=y

# Kernel modules -> Wireless Drivers
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_PACKAGE_kmod-brcmutil=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

# Perl
CONFIG_PACKAGE_perl=y
CONFIG_PACKAGE_perl-http-date=y
CONFIG_PACKAGE_perlbase-file=y
CONFIG_PACKAGE_perlbase-getopt=y
CONFIG_PACKAGE_perlbase-time=y
CONFIG_PACKAGE_perlbase-unicode=y
CONFIG_PACKAGE_perlbase-utf8=y

# LuCI -> Collections
CONFIG_PACKAGE_luci-ssl-openssl=y

# LuCI -> Modules
CONFIG_PACKAGE_luci-compat=y

# LuCI -> Applications
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-amlogic=y
# CONFIG_PACKAGE_luci-app-arpbind is not set
CONFIG_PACKAGE_luci-app-autoreboot=y
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts-services is not set
# CONFIG_PACKAGE_ddns-scripts_aliyun is not set
# CONFIG_PACKAGE_ddns-scripts_dnspod is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set
CONFIG_PACKAGE_luci-app-firewall=y
# CONFIG_PACKAGE_luci-app-frpc is not set
CONFIG_PACKAGE_luci-app-mosdns=y
# CONFIG_PACKAGE_luci-app-nginx is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-app-snmpd=y

# ShadowSocksR Plus is intentionally excluded; OpenClash is the proxy UI.
# CONFIG_PACKAGE_luci-app-ssr-plus is not set

CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-udpxy=y
# CONFIG_PACKAGE_luci-app-upnp is not set
CONFIG_PACKAGE_luci-app-vlmcsd=y
# CONFIG_PACKAGE_luci-app-vsftpd is not set
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-tailscale-community=y

# 主题
# Argon 3.x needs timeout's parent selected before Kconfig normalization.
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_luci-theme-argon-jerrykuku=y
# CONFIG_PACKAGE_luci-theme-design is not set
CONFIG_PACKAGE_luci-theme-material=y

# Network -> File Transfer
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# Network -> SSH
CONFIG_PACKAGE_openssh-sftp-server=y

# Network -> WirelessAPD
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpa-cli=y
CONFIG_PACKAGE_wpad-basic=y

# Network
CONFIG_PACKAGE_iw=y

# Utilities -> Compression
CONFIG_PACKAGE_bsdtar=y
CONFIG_PACKAGE_pigz=y

# Utilities -> Disc
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y

# Utilities -> Filesystem
CONFIG_PACKAGE_attr=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_BTRFS_PROGS_ZSTD=y
CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_lsattr=y
CONFIG_PACKAGE_mkf2fs=y
# xfsprogs 编译错误，暂时屏蔽
# CONFIG_PACKAGE_xfs-fsck is not set
# CONFIG_PACKAGE_xfs-mkfs is not set

# Utilities -> Shells
CONFIG_PACKAGE_bash=y

# Utilities -> Zoneinfo
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_zoneinfo-core=y

# Utilities
CONFIG_PACKAGE_acpid=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_getopt=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_pv=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_uuidgen=y
# CONFIG_PACKAGE_qemu-ga is not set

# Tailscale
CONFIG_PACKAGE_tailscale=y
# Tailscale connmark save/restore requires both userspace and kernel support.
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_ethtool=y

# Beszel Agent
CONFIG_PACKAGE_beszel-agent=y
